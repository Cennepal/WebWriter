{
  "name": "webwriter",
  "version": "2.0.1",
  "description": "A minimal, self-hosted novel writing web app with LiteWriter (WebDAV) integration",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-force-exit test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "writing",
    "novel",
    "editor",
    "litewriter",
    "webdav"
  ],
  "author": "Cennepal",
  "license": "MIT",
  "dependencies": {
    "@googleapis/drive": "^8.16.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "better-sqlite3-session-store": "^0.1.0",
    "docx": "^9.5.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "extract-zip": "^2.0.1",
    "multer": "^2.0.2",
    "webdav": "^4.11.5"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "webdav-server": "^2.6.2"
  }
}
