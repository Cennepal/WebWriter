<%
  const kindLabel = { manual: 'Manual', auto: 'Automatic', 'pre-restore': 'Before restore', legacy: 'WebWriter 1.x', uploaded: 'Uploaded', other: 'Other' };
%>
<%- include('partials/head') %>
<main class="container page container-narrow">
  <div class="page-header">
    <div><h1>Backups</h1><p>Snapshots of your library you can download, restore or send to Google Drive.</p></div>
    <div class="row">
      <button class="btn" type="button" data-upload-backup><svg class="icon"><use href="#i-upload"/></svg>Upload</button>
      <input type="file" accept=".zip,application/zip" data-upload-input hidden>
      <button class="btn btn-primary" type="button" data-create-backup data-remote="<%= remoteConfigured ? '1' : '0' %>"><svg class="icon"><use href="#i-plus"/></svg>Back up now</button>
    </div>
  </div>


  <section class="card">
    <% if (!backups.length) { %>
      <div class="card-body"><div class="empty" style="border:0;padding:2rem 1rem"><svg class="icon"><use href="#i-archive"/></svg><h3>No backups yet</h3><p>Create one now, or turn on automatic backups below.</p></div></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Backup</th><th>Size</th><th class="actions"><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
            <% backups.forEach(b => { %>
              <tr data-backup="<%= b.name %>">
                <td>
                  <div style="font-weight:550"><%= formatDate(b.created) %></div>
                  <div class="small muted"><span class="badge"><%= kindLabel[b.kind] %></span> <span class="faint"><%= relativeTime(b.created) %></span></div>
                </td>
                <td class="nowrap muted"><%= formatBytes(b.size) %></td>
                <td class="actions">
                  <a class="btn btn-sm" href="/backups/file/<%= encodeURIComponent(b.name) %>" download><svg class="icon"><use href="#i-download"/></svg><span class="sr-only">Download</span></a>
                  <details class="menu">
                    <summary class="icon-btn" aria-label="More"><svg class="icon"><use href="#i-more"/></svg></summary>
                    <div class="menu-panel">
                      <button class="menu-item" type="button" data-restore="merge"><svg class="icon"><use href="#i-rotate"/></svg>Restore (keep other novels)</button>
                      <button class="menu-item" type="button" data-restore="replace"><svg class="icon"><use href="#i-rotate"/></svg>Restore (replace library)</button>
                      <% if (driveConnected) { %><button class="menu-item" type="button" data-drive-upload><svg class="icon"><use href="#i-cloud"/></svg>Upload to Google Drive</button><% } %>
                      <div class="menu-sep"></div>
                      <button class="menu-item danger" type="button" data-delete-backup><svg class="icon"><use href="#i-trash"/></svg>Delete</button>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <form class="card" data-settings-form action="/backups/schedule" data-json-booleans>
    <div class="card-header"><h2>Automatic backups</h2><% if (s.last_auto_backup_at) { %><span class="small muted">Last: <%= relativeTime(s.last_auto_backup_at) %></span><% } %></div>
    <div class="card-body">
      <div class="form-grid">
        <div class="field">
          <label class="label" for="schedule">Schedule</label>
          <select class="select" id="schedule" name="schedule">
            <option value="off" <%= s.backup_schedule === 'off' ? 'selected' : '' %>>Off</option>
            <option value="daily" <%= s.backup_schedule === 'daily' ? 'selected' : '' %>>Every day</option>
            <option value="weekly" <%= s.backup_schedule === 'weekly' ? 'selected' : '' %>>Every week</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="keep">Keep the newest</label>
          <input class="input" id="keep" name="keep" type="number" min="1" max="100" value="<%= s.backup_keep %>">
          <span class="hint">Older automatic backups are removed. Manual ones are never removed.</span>
        </div>
      </div>
      <% if (remoteConfigured) { %>
        <label class="switch"><input type="checkbox" name="includeRemote" <%= s.backup_include_remote ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Include LiteWriter novels</strong><span class="hint">Also saves a copy of the novels on your phone (only if it is reachable at backup time).</span></span></label>
      <% } %>
      <% if (driveConnected) { %>
        <label class="switch"><input type="checkbox" name="driveAutoUpload" <%= s.drive_auto_upload ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Upload automatic backups to Google Drive</strong></span></label>
      <% } %>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Save</button></div>
  </form>

  <section class="card">
    <div class="card-header"><h2>Google Drive</h2><% if (driveConnected) { %><span class="badge badge-success"><span class="dot"></span>Connected</span><% } %></div>
    <div class="card-body">
      <% if (!driveAvailable) { %>
        <p class="muted">Google Drive uploads are not configured on this server. The administrator can enable them by setting <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code>.</p>
      <% } else if (driveConnected) { %>
        <div class="row-between"><p class="muted" style="margin:0">Backups are uploaded to the “WebWriter Backups” folder in your Drive.</p><button class="btn btn-danger" type="button" data-post="/backups/google/disconnect" data-reload-after>Disconnect</button></div>
      <% } else { %>
        <div class="row-between"><p class="muted" style="margin:0">Keep an off-site copy of your backups. WebWriter can only see files it created.</p><a class="btn" href="/backups/google/connect"><svg class="icon"><use href="#i-cloud"/></svg>Connect Google Drive</a></div>
      <% } %>
    </div>
  </section>

  <p class="hint">Restoring only changes your local library — never your account, settings or the novels on your LiteWriter device. A safety backup is made automatically before every restore. Backups from WebWriter 1.x can be restored too.</p>
</main>
<%- include('partials/foot', { scripts: ['settings', 'backups'] }) %>
