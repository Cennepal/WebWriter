<%
  const novelUrl = `/novels/${source}/${encodeURIComponent(novel.id)}`;
  const ed = prefs.editor;
%>
<%- include('partials/head', { bare: true, editor: true, bodyClass: 'editor-page' }) %>
<div style="--ed-font: <%= ed.fontStack %>; --ed-size: <%= ed.size %>px; --ed-width: <%= ed.width %>; --ed-lh: <%= ed.lineHeight %>" data-editor-root>
  <header class="ed-top" data-ed-top>
    <button class="icon-btn" type="button" data-drawer-open title="Chapters (Ctrl+Shift+O)" aria-label="Show chapters"><svg class="icon"><use href="#i-list"/></svg></button>
    <nav class="ed-crumbs" aria-label="Breadcrumb">
      <a href="<%= novelUrl %>" title="Back to novel"><svg class="icon"><use href="#i-chevron-left"/></svg><span class="novel-title"><%= novel.title %></span></a>
      <% if (book !== 'Main') { %><span class="sep">/</span><span class="book-name"><%= book %></span><% } %>
      <span class="sep">/</span><span class="current"><%= chapter %></span>
      <% if (source === 'remote') { %><span class="badge badge-accent" title="Saved directly to your LiteWriter device"><svg class="icon"><use href="#i-phone"/></svg><span class="book-name">Device</span></span><% } %>
    </nav>
    <div class="ed-actions">
      <span class="ed-status" data-status role="status"><span class="dot"></span><span data-status-text>Saved</span></span>
      <button class="icon-btn" type="button" data-typo-toggle title="Typography" aria-label="Typography settings"><svg class="icon"><use href="#i-type"/></svg></button>
      <button class="icon-btn" type="button" data-focus-toggle title="Focus mode (Ctrl+Shift+F)" aria-label="Focus mode"><svg class="icon"><use href="#i-eye"/></svg></button>
      <button class="icon-btn" type="button" data-fullscreen title="Full screen" aria-label="Full screen"><svg class="icon"><use href="#i-maximize"/></svg></button>
    </div>
  </header>

  <div class="ed-toolbar" data-ed-toolbar role="toolbar" aria-label="Formatting">
    <button class="icon-btn" type="button" data-md="bold" title="Bold (Ctrl+B)"><b>B</b></button>
    <button class="icon-btn" type="button" data-md="italic" title="Italic (Ctrl+I)"><i style="font-family:serif">I</i></button>
    <button class="icon-btn" type="button" data-md="heading" title="Heading">H</button>
    <button class="icon-btn" type="button" data-md="quote" title="Quote">“</button>
    <button class="icon-btn" type="button" data-md="break" title="Scene break">⁂</button>
  </div>

  <main class="ed-main">
    <div class="ed-paper">
      <h1 class="ed-chapter-title"><%= chapter %></h1>
      <label class="sr-only" for="ed-text">Chapter text</label>
      <textarea class="ed-text" id="ed-text" data-text spellcheck="<%= ed.spellcheck ? 'true' : 'false' %>" placeholder="Start writing…" autocomplete="off" autocapitalize="sentences"><%= content %></textarea>
    </div>
  </main>

  <footer class="ed-footer" data-ed-footer>
    <div class="row" style="gap:1rem">
      <span><strong data-words>0</strong> words</span>
      <span class="faint" data-session-words title="Words added in this session"></span>
      <span class="goal" data-goal hidden title="Daily goal"><svg class="icon"><use href="#i-target"/></svg><span class="progress"><span data-goal-bar></span></span><span data-goal-text></span></span>
    </div>
    <div class="ed-nav">
      <a class="btn btn-ghost btn-sm" data-prev hidden><svg class="icon"><use href="#i-chevron-left"/></svg><span data-label></span></a>
      <a class="btn btn-ghost btn-sm" data-next hidden><span data-label></span><svg class="icon"><use href="#i-chevron-right"/></svg></a>
    </div>
  </footer>

  <div class="popover" data-typo hidden>
    <div class="field">
      <span class="label small">Font</span>
      <div class="seg" data-font-seg>
        <% Object.entries(EDITOR_FONTS).forEach(([key, f]) => { %><button type="button" data-font="<%= key %>" class="<%= ed.font === key ? 'active' : '' %>"><%= f.label %></button><% }) %>
      </div>
    </div>
    <div class="field"><label class="label small" for="ed-size">Text size <span class="faint" data-size-val><%= ed.size %>px</span></label><input type="range" id="ed-size" min="12" max="32" step="1" value="<%= ed.size %>" data-size></div>
    <div class="field"><label class="label small" for="ed-width">Line length <span class="faint" data-width-val><%= ed.width %></span></label><input type="range" id="ed-width" min="28" max="80" step="1" value="<%= ed.width %>" data-width></div>
    <div class="field"><label class="label small" for="ed-lh">Line spacing <span class="faint" data-lh-val><%= ed.lineHeight %></span></label><input type="range" id="ed-lh" min="1.2" max="2.4" step="0.05" value="<%= ed.lineHeight %>" data-lh></div>
    <label class="switch" style="margin:0"><input type="checkbox" data-typewriter <%= ed.typewriter ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Typewriter scrolling</strong><span class="hint">Keep the current line centred.</span></span></label>
  </div>
</div>

<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer" data-drawer aria-label="Chapters">
  <div class="drawer-header">
    <strong><%= novel.title %></strong>
    <button class="icon-btn" type="button" data-drawer-close aria-label="Close"><svg class="icon"><use href="#i-x"/></svg></button>
  </div>
  <div data-drawer-list><p class="muted small" style="padding:1rem"><span class="spinner"></span> Loading chapters…</p></div>
</aside>

<dialog class="dialog dialog-wide" id="conflict-dialog">
  <form method="dialog">
    <div class="dialog-header"><h2>This chapter changed elsewhere</h2></div>
    <div class="dialog-body">
      <p><%= source === 'remote' ? 'Someone (probably you, on your phone) edited this chapter in LiteWriter after you opened it here.' : 'This chapter was saved from another tab or device after you opened it here.' %> What should happen?</p>
      <p class="hint">Your text from this page is kept as a draft in this browser either way.</p>
      <details style="margin-top:.75rem"><summary class="small">Show the other version</summary><div class="diff-view" data-theirs></div></details>
    </div>
    <div class="dialog-footer">
      <button class="btn" value="cancel">Decide later</button>
      <button class="btn" value="theirs">Load the other version</button>
      <button class="btn btn-primary" value="mine">Keep my version</button>
    </div>
  </form>
</dialog>

<script type="application/json" id="page-data"><%- json({ source, id: novel.id, book, chapter, version, novelTitle: novel.title, dailyGoal: prefs.dailyGoal, wordsToday, typewriter: ed.typewriter }) %></script>
<%- include('partials/foot', { scripts: ['editor'] }) %>
