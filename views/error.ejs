<%- include('partials/head', { bare: !user }) %>
<main class="container error-page">
  <div class="code"><%= status %></div>
  <p><%= message %></p>
  <div class="row" style="justify-content:center">
    <% if (status >= 500 || status === 502) { %><a class="btn" href="" data-reload><svg class="icon"><use href="#i-refresh"/></svg>Try again</a><% } %>
    <a class="btn btn-primary" href="<%= user ? '/library' : '/login' %>"><%= user ? 'Back to library' : 'Sign in' %></a>
  </div>
</main>
<%- include('partials/foot') %>
