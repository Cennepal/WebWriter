<%
  const tabs = [
    { id: 'account', label: 'Account', icon: 'user' },
    { id: 'appearance', label: 'Appearance', icon: 'sun' },
    { id: 'writing', label: 'Writing', icon: 'pen' },
    { id: 'litewriter', label: 'LiteWriter', icon: 'phone' }
  ];
%>
<%- include('partials/head') %>
<main class="container page">
  <div class="page-header"><div><h1>Settings</h1><p>Everything here only affects your own account.</p></div></div>
  <div class="layout-side">
    <nav class="side-nav" aria-label="Settings sections">
      <% tabs.forEach(t => { %><a href="/settings/<%= t.id %>" <%- tab === t.id ? 'aria-current="page"' : '' %>><svg class="icon"><use href="#i-<%= t.icon %>"/></svg><%= t.label %></a><% }) %>
    </nav>
    <div>

<% if (tab === 'account') { %>
  <section class="card">
    <div class="card-header"><h2>Profile</h2></div>
    <div class="card-body">
      <div class="row-between">
        <div><div class="label">Username</div><div class="muted"><%= user.username %></div></div>
        <span class="badge <%= user.isAdmin ? 'badge-accent' : '' %>"><%= user.isAdmin ? 'Administrator' : 'Writer' %></span>
      </div>
    </div>
  </section>

  <form class="card" data-settings-form action="/settings/account/password" data-reset>
    <div class="card-header"><h2>Change password</h2></div>
    <div class="card-body">
      <div class="field"><label class="label" for="pw-current">Current password</label><input class="input" id="pw-current" name="current" type="password" autocomplete="current-password" required></div>
      <div class="form-grid">
        <div class="field"><label class="label" for="pw-new">New password</label><input class="input" id="pw-new" name="password" type="password" autocomplete="new-password" minlength="8" required></div>
        <div class="field"><label class="label" for="pw-confirm">Confirm new password</label><input class="input" id="pw-confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required></div>
      </div>
      <p class="hint">Changing your password signs you out everywhere else.</p>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Change password</button></div>
  </form>

  <form class="card" data-settings-form action="/settings/account/timezone">
    <div class="card-header"><h2>Time zone</h2></div>
    <div class="card-body">
      <div class="field">
        <label class="label" for="tz">Your time zone</label>
        <select class="select" id="tz" name="timezone" data-tz-select>
          <option value="">Server default</option>
          <% timezones.forEach(z => { %><option value="<%= z %>" <%= s.timezone === z ? 'selected' : '' %>><%= z.replace(/_/g, ' ') %></option><% }) %>
        </select>
        <span class="hint">Decides when your writing day starts for statistics and daily goals.</span>
      </div>
    </div>
    <div class="card-footer"><button class="btn" type="button" data-detect-tz>Detect</button><button class="btn btn-primary" type="submit">Save</button></div>
  </form>

  <section class="card">
    <div class="card-header"><h2>Sessions</h2></div>
    <div class="card-body row-between">
      <p class="muted" style="margin:0">Lost a device or used a shared computer? Sign out everywhere except here.</p>
      <button class="btn" type="button" data-post="/settings/account/signout-others">Sign out other devices</button>
    </div>
  </section>
<% } %>

<% if (tab === 'appearance') { %>
  <form class="card" data-settings-form action="/settings/appearance" enctype="multipart/form-data">
    <div class="card-header"><h2>Theme</h2></div>
    <div class="card-body">
      <div class="field">
        <span class="label">Colour scheme</span>
        <div class="choice-grid">
          <% [['system','System','monitor'],['light','Light','sun'],['dark','Dark','moon']].forEach(([v,l,i]) => { %>
            <label class="choice"><input type="radio" name="theme" value="<%= v %>" <%= prefs.theme === v ? 'checked' : '' %>><span><svg class="icon"><use href="#i-<%= i %>"/></svg><%= l %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="field">
        <span class="label">Accent colour</span>
        <div class="choice-grid">
          <% Object.entries(accents).forEach(([k, a]) => { %>
            <label class="choice"><input type="radio" name="accent" value="<%= k %>" <%= prefs.accent === k ? 'checked' : '' %>><span><span class="swatch" style="background:<%= a.color %>"></span><%= a.label %></span></label>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="card-header" style="border-top:1px solid var(--border)"><h2>Background image</h2></div>
    <div class="card-body">
      <label class="switch"><input type="checkbox" name="background_enabled" <%= s.background_enabled ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Show a background image</strong><span class="hint">Displayed behind the app, softened so text stays readable.</span></span></label>
      <% if (s.background_url) { %>
        <div class="field"><span class="label">Current image</span><img src="<%= s.background_url %>" alt="" style="max-height:120px;border-radius:var(--radius-sm);border:1px solid var(--border)"></div>
      <% } %>
      <div class="form-grid">
        <div class="field"><label class="label" for="bg-file">Upload an image</label><input class="input" id="bg-file" name="background" type="file" accept="image/*"></div>
        <div class="field"><label class="label" for="bg-url">…or use an image URL</label><input class="input" id="bg-url" name="background_url" value="<%= s.background_url.startsWith('/uploads/') ? '' : s.background_url %>" placeholder="https://…"></div>
      </div>
      <div class="field">
        <label class="label" for="bg-dim">Soften image <span class="faint" data-range-out="bg-dim"><%= Math.round(s.background_dim * 100) %>%</span></label>
        <input type="range" id="bg-dim" name="background_dim" min="0" max="0.95" step="0.05" value="<%= s.background_dim %>" data-range-percent>
      </div>
      <label class="switch"><input type="checkbox" name="background_in_editor" <%= s.background_in_editor ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Also show it in the editor</strong><span class="hint">Off keeps the writing view plain and distraction-free.</span></span></label>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Save appearance</button></div>
  </form>
<% } %>

<% if (tab === 'writing') { %>
  <form class="card" data-settings-form action="/settings/writing">
    <div class="card-header"><h2>Editor</h2></div>
    <div class="card-body">
      <div class="field">
        <span class="label">Font</span>
        <div class="choice-grid">
          <% Object.entries(fonts).forEach(([k, f]) => { %>
            <label class="choice"><input type="radio" name="editor_font" value="<%= k %>" <%= s.editor_font === k ? 'checked' : '' %>><span style="font-family:<%= f.stack %>"><%= f.label %></span></label>
          <% }) %>
        </div>
      </div>
      <div class="form-grid">
        <div class="field"><label class="label" for="ed-size">Text size <span class="faint" data-range-out="ed-size"><%= s.editor_size %></span></label><input type="range" id="ed-size" name="editor_size" min="12" max="32" value="<%= s.editor_size %>" data-range></div>
        <div class="field"><label class="label" for="ed-width">Line length <span class="faint" data-range-out="ed-width"><%= s.editor_width %></span></label><input type="range" id="ed-width" name="editor_width" min="28" max="80" value="<%= s.editor_width %>" data-range></div>
        <div class="field"><label class="label" for="ed-lh">Line spacing <span class="faint" data-range-out="ed-lh"><%= s.editor_line_height %></span></label><input type="range" id="ed-lh" name="editor_line_height" min="1.2" max="2.4" step="0.05" value="<%= s.editor_line_height %>" data-range></div>
      </div>
      <label class="switch"><input type="checkbox" name="editor_spellcheck" <%= s.editor_spellcheck ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Spell checking</strong><span class="hint">Uses your browser's spell checker.</span></span></label>
      <label class="switch"><input type="checkbox" name="editor_typewriter" <%= s.editor_typewriter ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Typewriter scrolling</strong><span class="hint">Keeps the line you're writing in the middle of the screen.</span></span></label>
    </div>
    <div class="card-header" style="border-top:1px solid var(--border)"><h2>Goals</h2></div>
    <div class="card-body">
      <div class="field" style="max-width:260px">
        <label class="label" for="goal">Daily word goal</label>
        <input class="input" id="goal" name="daily_goal" type="number" min="0" max="100000" step="50" value="<%= s.daily_goal %>">
        <span class="hint">0 turns the goal off. Progress shows in the editor and statistics.</span>
      </div>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Save</button></div>
  </form>
<% } %>

<% if (tab === 'litewriter') { %>
  <form class="card" data-settings-form action="/settings/litewriter" data-litewriter-form>
    <div class="card-header"><h2>LiteWriter connection</h2><% if (s.litewriter_enabled && s.litewriter_url) { %><span class="badge badge-success"><span class="dot"></span>Enabled</span><% } %></div>
    <div class="card-body">
      <p class="muted">WebWriter can open and edit the novels stored in the <strong>LiteWriter</strong> Android app. In the app, start the WebDAV server and enter the address it shows below. Your phone and this server need to reach each other — the same Wi-Fi works, <a href="https://tailscale.com" target="_blank" rel="noopener">Tailscale</a> works from anywhere.</p>
      <label class="switch"><input type="checkbox" name="enabled" <%= s.litewriter_enabled ? 'checked' : '' %>><span class="switch-track"></span><span class="switch-text"><strong>Show my LiteWriter novels</strong></span></label>
      <div class="field">
        <label class="label" for="lw-url">WebDAV address</label>
        <input class="input" id="lw-url" name="url" value="<%= s.litewriter_url %>" placeholder="http://192.168.1.50:8080" autocomplete="off" inputmode="url">
      </div>
      <div class="form-grid">
        <div class="field"><label class="label" for="lw-user">Username <span class="faint">(if set in the app)</span></label><input class="input" id="lw-user" name="username" value="<%= s.litewriter_username %>" autocomplete="off"></div>
        <div class="field">
          <label class="label" for="lw-pass">Password</label>
          <input class="input" id="lw-pass" name="password" type="password" autocomplete="new-password" placeholder="<%= hasLitewriterPassword ? '•••••••• (unchanged)' : '' %>">
          <% if (hasLitewriterPassword) { %><label class="row small muted" style="margin-top:.35rem"><input type="checkbox" name="clearPassword"> Remove saved password</label><% } %>
        </div>
      </div>
      <div data-test-result></div>
    </div>
    <div class="card-footer">
      <button class="btn" type="button" data-test-connection><svg class="icon"><use href="#i-link"/></svg>Test connection</button>
      <button class="btn btn-primary" type="submit">Save</button>
    </div>
  </form>
  <section class="card">
    <div class="card-body">
      <h3 style="margin-bottom:.5rem">How it works</h3>
      <ul class="muted" style="margin:0;padding-left:1.2rem">
        <li>Every folder in LiteWriter's storage is shown as a novel. Text files in the folder are the main chapters, sub-folders become books.</li>
        <li>Edits are saved straight to the phone. If a chapter was changed on the phone meanwhile, you'll be asked which version to keep.</li>
        <li>The library never waits for your phone: LiteWriter novels load in the background, and word counts are cached so only changed files are downloaded.</li>
        <li>Use “Copy to my library” on a novel to keep an independent copy on this server, or enable LiteWriter snapshots in Backups.</li>
      </ul>
    </div>
  </section>
<% } %>

    </div>
  </div>
</main>
<%- include('partials/foot', { scripts: ['settings'] }) %>
