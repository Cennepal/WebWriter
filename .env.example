# Port and interface to listen on
PORT=3000
# HOST=0.0.0.0

# Where novels, backups and the database are stored (default: ./data)
# DATA_DIR=./data

# Secret used to sign session cookies. If unset, one is generated and stored in DATA_DIR.
# SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of this app, e.g. https://write.example.com
# Used for invite links and the Google OAuth callback. Optional; detected from requests otherwise.
# BASE_URL=

# Reverse proxy trust (default: loopback, linklocal, uniquelocal). Use "true" to trust any proxy.
# TRUST_PROXY=

# Secure cookies: "auto" (default, secure whenever the request is HTTPS), "true" or "false".
# COOKIE_SECURE=auto

# Optional: Google Drive backup uploads. Create OAuth credentials (Web application) in the
# Google Cloud Console, enable the Drive API and add <BASE_URL>/backups/google/callback as
# an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LiteWriter (WebDAV) tuning
# LITEWRITER_TIMEOUT_MS=15000
# LITEWRITER_CONCURRENCY=4
# LITEWRITER_CACHE_MS=60000
